# Backend API base URL (the FastAPI server, local dev or deployed)
NEXT_PUBLIC_API_URL=http://localhost:8123

# Supabase — login only. The publishable key is safe to expose in the
# browser; never put the secret/service key here (that's backend-only,
# in backend/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
