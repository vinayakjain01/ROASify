# CORS — comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*

# GrowifyOS Live Sync integration (backend/integrations/growifyos_client.py)
# Never commit the real API key.
GROWIFYOS_API_KEY=
GROWIFYOS_BASE_URL=https://loop.growify.in/api/v1/roasify

# Supabase — team/user/brand-access data (auth + authorization). Never
# commit real values. SECRET key is server-only — it bypasses RLS entirely.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Use the pooler host (aws-0-<region>.pooler.supabase.com), not
# db.<ref>.supabase.co directly — that host is IPv6-only.
DATABASE_URL=

# Where to send invited users to set their password (the frontend's real
# host, e.g. https://roa-sify.vercel.app) — must also be added to Supabase's
# Authentication > URL Configuration > Redirect URLs allowlist, or Supabase
# silently falls back to the project's Site URL instead.
FRONTEND_URL=
